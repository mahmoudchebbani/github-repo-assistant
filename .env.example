DATABASE_URL=postgresql://assistant:assistant@localhost:5433/assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PRICE_INPUT_PER_1M=0.15
PRICE_OUTPUT_PER_1M=0.60
GITHUB_TOKEN=
# One or more owner/repo slugs, comma-separated; ingest and reindex process each in turn.
REPOS=DataTalksClub/llm-zoomcamp
# Applies to issues, PRs and comments; PRs have no server-side `since`, so ingest.py stops early instead.
INGEST_SINCE=2024-01-01
DOCS_GLOBS=**/*.md
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_CHARS=800
CHUNK_OVERLAP=100
RETRIEVAL_MODE=hybrid
ANSWER_PROMPT=A
TOP_K=5
MAX_RETRIES=2
